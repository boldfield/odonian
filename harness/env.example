# Odonian fleet config — copy to ~/.odonian/env and fill in. NOT versioned (it holds the token).
# Sourced by agent.sh. The ${VAR:-default} form lets you override any value per-invocation.

# The running Odonian instance + a bearer token.
export ODONIAN_URL="${ODONIAN_URL:-https://odonian.example.com}"
# The token can be a literal, or pulled from wherever you keep it, e.g. a k8s secret:
#   export ODONIAN_TOKEN="$(kubectl get secret -n odonian odonian-secret -o jsonpath='{.data.token}' | base64 -d)"
export ODONIAN_TOKEN="${ODONIAN_TOKEN:-<bearer-token>}"

# Project scope:
#   ODONIAN_PROJECT=<uuid>  -> SINGLE-project: pin a slot to that board + its local checkout
#                               (ODONIAN_REPO). Override per run:
#                                 ODONIAN_PROJECT=<id> ODONIAN_REPO=~/projects/<repo> ./worker.sh <slot>
#   ODONIAN_PROJECT=all     -> MULTI-project: discover + drain every project with claimable work,
#                               cloning each repo on demand (ODONIAN_REPO is then ignored). e.g.:
#                                 ODONIAN_PROJECT=all ./worker.sh <slot>
#                               Optionally ODONIAN_PROJECTS=<id,id,…> restricts which boards to touch.
export ODONIAN_PROJECT="${ODONIAN_PROJECT:-<project-uuid-or-all>}"
export ODONIAN_REPO="${ODONIAN_REPO:-$HOME/projects/<repo>}"   # single-project mode only

# Optional: where harness STATE lives (agent ids, worktrees, repo clones). Defaults to ~/.odonian.
# export ODONIAN_HOME="$HOME/.odonian"
